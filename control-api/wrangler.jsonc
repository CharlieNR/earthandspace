{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earth-systems-control",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://charlienr.github.io"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYSTEM_STATE",
        "class_name": "SystemState"
      }
    ]
  },
  "exports": {
    "SystemState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "SESSION_SIGNING_KEY"]
  }
}
